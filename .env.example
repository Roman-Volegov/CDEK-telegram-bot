# Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token

# Кто может пользоваться ботом (Telegram user id через запятую).
# Пусто = доступен всем. Узнать свой id: напишите боту /id
# ALLOWED_TELEGRAM_IDS=123456789,987654321
ALLOWED_TELEGRAM_IDS=

# CDEK API (https://api.cdek.ru/account)
CDEK_CLIENT_ID=your_cdek_client_id
CDEK_CLIENT_SECRET=your_cdek_client_secret
# true = https://api.edu.cdek.ru (тест), false = https://api.cdek.ru
CDEK_TEST_MODE=true

# DaData (https://dadata.ru/profile/#info)
DADATA_API_KEY=your_dadata_api_key
DADATA_SECRET_KEY=your_dadata_secret_key

# Склад / ПВЗ отгрузки СДЭК
CDEK_SHIPMENT_POINT=MSK90

# 1 — интернет-магазин, 2 — доставка
CDEK_ORDER_TYPE=1
# Принудительно передаётся в заказ как sender
CDEK_SENDER_NAME=Волегов Роман Андреевич
CDEK_SENDER_PHONE=+79127814466

# Габариты посылки по умолчанию (см, вес в граммах)
DEFAULT_WEIGHT_G=100
DEFAULT_LENGTH_CM=10
DEFAULT_WIDTH_CM=10
DEFAULT_HEIGHT_CM=5

# Товар в декларации / накладной
DEFAULT_ITEM_NAME=Бижутерия
DEFAULT_ITEM_WARE_KEY=JEWELRY-1

# PostgreSQL / Redis
DATABASE_URL=postgresql+asyncpg://cdek:cdek@db:5432/cdek_bot
REDIS_URL=redis://redis:6379/0

# Локальный запуск без Docker — раскомментируйте:
# DATABASE_URL=postgresql+asyncpg://cdek:cdek@localhost:5432/cdek_bot
# REDIS_URL=redis://localhost:6379/0

# Хранение PDF
PDF_STORAGE_PATH=./storage/pdfs