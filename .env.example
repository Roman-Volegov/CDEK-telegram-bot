# Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token

# CDEK API (https://api.cdek.ru/account)
CDEK_CLIENT_ID=your_cdek_client_id
CDEK_CLIENT_SECRET=your_cdek_client_secret
# true = https://api.edu.cdek.ru (тест), false = https://api.cdek.ru
CDEK_TEST_MODE=true

# DaData (https://dadata.ru/profile/#info)
DADATA_API_KEY=your_dadata_api_key
DADATA_SECRET_KEY=your_dadata_secret_key

# Склад / ПВЗ отгрузки СДЭК
CDEK_SHIPMENT_POINT=MSK90

# Габариты посылки по умолчанию (см, вес в граммах)
DEFAULT_WEIGHT_G=1000
DEFAULT_LENGTH_CM=30
DEFAULT_WIDTH_CM=20
DEFAULT_HEIGHT_CM=10

# Товар в декларации
DEFAULT_ITEM_NAME=Товар
DEFAULT_ITEM_WARE_KEY=ITEM-1

# PostgreSQL / Redis
DATABASE_URL=postgresql+asyncpg://cdek:cdek@db:5432/cdek_bot
REDIS_URL=redis://redis:6379/0

# Локальный запуск без Docker — раскомментируйте:
# DATABASE_URL=postgresql+asyncpg://cdek:cdek@localhost:5432/cdek_bot
# REDIS_URL=redis://localhost:6379/0

# Хранение PDF
PDF_STORAGE_PATH=./storage/pdfs