BOT_TOKEN=123456:ABC-DEF
ENCRYPTION_KEY=

# Администраторы бота (получают заявки и могут подтверждать/отклонять)
# Можно указать Telegram user id и/или @username через запятую
# Рекомендуется хотя бы один числовой ID — заявки уходят надёжнее
ADMIN_TELEGRAM_IDS=123456789,@admin_username

# Опционально: старый whitelist — числовые ID сразу получают approved при старте
# Если ADMIN_TELEGRAM_IDS пуст, этот список также используется как список админов
ALLOWED_TELEGRAM_IDS=

DATABASE_URL=postgresql+asyncpg://cdek:cdek@db:5432/cdek_bot
REDIS_URL=redis://redis:6379/0

# Куда сохранять PDF накладных и штрихкодов
# PDF_STORAGE_PATH=./storage/pdfs
